# Expects PACIFIC_BUILDDIR_ABS and PACIFIC_ROOT_ABS

# Derived config

MKDIR ?= mkdir
CP ?= cp
LN ?= ln
RM ?= rm 

PACIFIC_THIRDPARTY_DIR := $(PACIFIC_ROOT_ABS)/third_party

.PHONY: all clean

all: third_party-basilisk third_party-hdf5 third_party-xercesc third_party-zlib

clean: 
	@$(RM) -rf $(PACIFIC_THIRDPARTY_BUILDDIR_ABS) $(PACIFIC_THIRDPARTY_INSTALLDIR_ABS)

third_party-builddir: $(PACIFIC_THIRDPARTY_BUILDDIR_ABS)

third_party-installdir: $(PACIFIC_THIRDPARTY_INSTALLDIR_ABS)

$(PACIFIC_THIRDPARTY_BUILDDIR_ABS):
	@$(MKDIR) -p "$@"

$(PACIFIC_THIRDPARTY_INSTALLDIR_ABS):
	@$(MKDIR) -p "$@"

# =============================================================================
# BASILISK
# =============================================================================

PACIFIC_SUBMODULE_BASILISK := $(PACIFIC_THIRDPARTY_DIR)/basilisk/basilisk_submodule
PACIFIC_SUBMODULE_BASILISK_BINDIR := $(PACIFIC_THIRDPARTY_BUILDDIR_ABS)/basilisk
PACIFIC_SUBMODULE_BASILISK_INSTALLDIR := $(PACIFIC_THIRDPARTY_INSTALLDIR_ABS)
PACIFIC_SUBMODULE_BASILISK_STAMPDIR := $(PACIFIC_SUBMODULE_BASILISK_BINDIR)/stamp
PACIFIC_SUBMODULE_BASILISK_CMAKE_DEFS ?= \
	-DCMAKE_INSTALL_PREFIX=$(PACIFIC_SUBMODULE_BASILISK_INSTALLDIR)
PACIFIC_SUBMODULE_BASILISK_CONFIGURE_STAMP := $(PACIFIC_SUBMODULE_BASILISK_STAMPDIR)/configure.stamp
PACIFIC_SUBMODULE_BASILISK_BUILD_STAMP := $(PACIFIC_SUBMODULE_BASILISK_STAMPDIR)/build.stamp
PACIFIC_SUBMODULE_BASILISK_INSTALL_STAMP := $(PACIFIC_SUBMODULE_BASILISK_STAMPDIR)/install.stamp

third_party-basilisk: $(PACIFIC_SUBMODULE_BASILISK_INSTALL_STAMP)

$(PACIFIC_SUBMODULE_BASILISK_STAMPDIR): | $(PACIFIC_THIRDPARTY_BUILDDIR_ABS)
	@$(MKDIR) -p "$@"

third_party-basilisk-configure: $(PACIFIC_SUBMODULE_BASILISK_CONFIGURE_STAMP)

$(PACIFIC_SUBMODULE_BASILISK_CONFIGURE_STAMP): | $(PACIFIC_THIRDPARTY_INSTALLDIR_ABS) $(PACIFIC_SUBMODULE_BASILISK_STAMPDIR)
	@$(CMAKE) -S "$(PACIFIC_SUBMODULE_BASILISK)" -B "$(PACIFIC_SUBMODULE_BASILISK_BINDIR)" -G "Unix Makefiles" $(PACIFIC_SUBMODULE_BASILISK_CMAKE_DEFS)
	@touch "$@"

third_party-basilisk-build: $(PACIFIC_SUBMODULE_BASILISK_BUILD_STAMP)

$(PACIFIC_SUBMODULE_BASILISK_BUILD_STAMP): $(PACIFIC_SUBMODULE_BASILISK_CONFIGURE_STAMP)
	@$(CMAKE) --build "$(PACIFIC_SUBMODULE_BASILISK_BINDIR)" --parallel
	@touch "$@"

third_party-basilisk-install: $(PACIFIC_SUBMODULE_BASILISK_INSTALL_STAMP)

$(PACIFIC_SUBMODULE_BASILISK_INSTALL_STAMP): $(PACIFIC_SUBMODULE_BASILISK_BUILD_STAMP)
	@$(CMAKE) --install "$(PACIFIC_SUBMODULE_BASILISK_BINDIR)"
	@touch "$@"

# =============================================================================
# HDF5
# =============================================================================

PACIFIC_SUBMODULE_HDF5 := $(PACIFIC_THIRDPARTY_DIR)/hdf5/hdf5_submodule
PACIFIC_SUBMODULE_HDF5_BINDIR := $(PACIFIC_THIRDPARTY_BUILDDIR_ABS)/hdf5
