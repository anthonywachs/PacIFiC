PACIFIC_SUBMODULE_HDF5_STAMPDIR := $(PACIFIC_SUBMODULE_HDF5_BINDIR)/stamp
PACIFIC_SUBMODULE_HDF5_CMAKE_DEFS ?= \
	-DHDF5_ENABLE_PARALLEL=ON \
	-DBUILD_SHARED_LIBS=ON \
	-DHDF5_ALLOW_EXTERNAL_SUPPORT:STRING=GIT \
	-DHDF5_ENABLE_ZLIB_SUPPORT:BOOL=ON \
	-DHDF5_ENABLE_SZIP_SUPPORT:BOOL=ON \
	-DCMAKE_INSTALL_PREFIX=$(PACIFIC_SUBMODULE_HDF5_INSTALLDIR)
PACIFIC_SUBMODULE_HDF5_CONFIGURE_STAMP := $(PACIFIC_SUBMODULE_HDF5_STAMPDIR)/configure.stamp
PACIFIC_SUBMODULE_HDF5_BUILD_STAMP := $(PACIFIC_SUBMODULE_HDF5_STAMPDIR)/build.stamp
PACIFIC_SUBMODULE_HDF5_INSTALL_STAMP := $(PACIFIC_SUBMODULE_HDF5_STAMPDIR)/install.stamp

third_party-hdf5: $(PACIFIC_SUBMODULE_HDF5_INSTALL_STAMP)

$(PACIFIC_SUBMODULE_HDF5_STAMPDIR): | $(PACIFIC_THIRDPARTY_BUILDDIR_ABS)
	@$(MKDIR) -p "$@"

third_party-hdf5-configure: $(PACIFIC_SUBMODULE_HDF5_CONFIGURE_STAMP)

$(PACIFIC_SUBMODULE_HDF5_CONFIGURE_STAMP): | $(PACIFIC_THIRDPARTY_INSTALLDIR_ABS) $(PACIFIC_SUBMODULE_HDF5_STAMPDIR)
	@$(CMAKE) -S "$(PACIFIC_SUBMODULE_HDF5)" -B "$(PACIFIC_SUBMODULE_HDF5_BINDIR)" -G "Unix Makefiles" $(PACIFIC_SUBMODULE_HDF5_CMAKE_DEFS)
	@touch "$@"

third_party-hdf5-build: $(PACIFIC_SUBMODULE_HDF5_BUILD_STAMP)

$(PACIFIC_SUBMODULE_HDF5_BUILD_STAMP): $(PACIFIC_SUBMODULE_HDF5_CONFIGURE_STAMP)
	@$(CMAKE) --build "$(PACIFIC_SUBMODULE_HDF5_BINDIR)" --parallel
	@touch "$@"

third_party-hdf5-install: $(PACIFIC_SUBMODULE_HDF5_INSTALL_STAMP)

$(PACIFIC_SUBMODULE_HDF5_INSTALL_STAMP): $(PACIFIC_SUBMODULE_HDF5_BUILD_STAMP)
	@$(CMAKE) --install "$(PACIFIC_SUBMODULE_HDF5_BINDIR)"
	@touch "$@"

