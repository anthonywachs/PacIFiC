{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 12,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Default",
      "displayName": "Default (Release)",
      "description": "Release build with system default generator.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/release",
        "BUILD_THIRD_PARTY_HDF5": "OFF",
        "BUILD_THIRD_PARTY_XERCESC": "OFF",
        "BUILD_THIRD_PARTY_ZLIB": "OFF",
        "BUILD_THIRD_PARTY_PETSC": "OFF",
        "PACIFIC_DEV_ENV": "ON"
      }
    },
    {
      "name": "Mac OS X (ARM)",
      "displayName": "MacOS (ARM) (Release)",
      "description": "Release build with system default generator.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/release",
        "CMAKE_INSTALL_RPATH": "${sourceDir}/install/release/lib",
        "BUILD_THIRD_PARTY_HDF5": "OFF",
        "BUILD_THIRD_PARTY_XERCESC": "OFF",
        "BUILD_THIRD_PARTY_ZLIB": "OFF",
        "BUILD_THIRD_PARTY_PETSC": "OFF",
        "PACIFIC_DEV_ENV": "ON"
      }
    },
    {
      "name": "Fir",
      "displayName": "HPC Release for Fir",
      "description": "Release buuild for Fir with specific compiler and flags.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/fir_release",
      "cacheVariables": {
      	"CMAKE_INSTALL_PREFIX": "${sourceDir}/install/fir_release",
        "CMAKE_INSTALL_RPATH": "${sourceDir}/install/fir_release/lib64",
        "USE_SUBMODULES": "ON",
        "OCTREE_BASILISK_PROVIDER": "VENDORED",
        "BUILD_THIRD_PARTY_HDF5": "OFF",
        "BUILD_THIRD_PARTY_XERCESC": "OFF",
        "BUILD_THIRD_PARTY_ZLIB": "OFF"
      }
    },
    {
      "name": "Debug",
      "displayName": "Debug",
      "description": "Build with debug info and no optimization.",
      "inherits": "Default",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/debug"
      }
    },
    {
      "name": "RelWithWarnings",
      "displayName": "RelWithWarnings",
      "description": "Custom build with extra warnings enabled.",
      "inherits": "Default",
      "binaryDir": "${sourceDir}/build/rel-with-warnings",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithWarnings",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/rel_with_warnings"
      }
    },
    {
      "name": "Sockeye",
      "displayName": "HPC Release for Sockeye",
      "description": "Release build for Sockeye with specific compiler and flags.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/sockeye_release",
      "environment": {
      	"CC":"/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/x86_64-pc-linux-gnu/gcc-bin/12/gcc",
        "CXX":"/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/x86_64-pc-linux-gnu/gcc-bin/12/g++"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/sockeye_release",
        "CMAKE_BUILD_RPATH": "/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/lib64:/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/lib/gcc/x86_64-pc-linux-gnu/12/",
        "CMAKE_INSTALL_RPATH": "/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/lib64:/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/lib/gcc/x86_64-pc-linux-gnu/12/",
        "CMAKE_SKIP_INSTALL_RPATH": "FALSE",
        "USE_SUBMODULES": "ON",
        "OCTREE_BASILISK_PROVIDER": "VENDORED",
        "BUILD_THIRD_PARTY_HDF5": "OFF",
        "BUILD_THIRD_PARTY_XERCESC": "OFF",
        "BUILD_THIRD_PARTY_ZLIB": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Default",
      "configurePreset": "Default",
      "description": "Build the release configuration",
      "jobs": 16
    },
    {
      "name": "Mac OS X (ARM)",
      "configurePreset": "Mac OS X (ARM)",
      "description": "Build the macOS ARM release configuration",
      "jobs": 16
    },
    {
      "name": "Fir",
      "configurePreset": "Fir",
      "description": "Build the Fir configuration",
      "jobs": 1
    },
    {
      "name": "Debug",
      "configurePreset": "Debug",
      "description": "Build the debug configuration",
      "jobs": 16
    },
    {
      "name": "RelWithWarnings",
      "configurePreset": "RelWithWarnings",
      "description": "Build the RelWithWarnings configuration",
      "jobs": 16
    },
    {
      "name": "Sockeye",
      "configurePreset": "Sockeye",
      "description": "Build on Sockeye",
      "jobs": 1
    }
  ],
  "testPresets": [
    {
      "name": "Default",
      "configurePreset": "Default",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Mac OS X (ARM)",
      "configurePreset": "Mac OS X (ARM)",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Debug",
      "configurePreset": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
