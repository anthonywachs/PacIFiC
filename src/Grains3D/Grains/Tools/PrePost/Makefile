.PHONY: all position rotation shape

all: position rotation shape

POSITION_SRCDIR := $(PREPOST_SRCDIR)/Position 
  
POSITION_MAKE = @$(MAKE) -C $(POSITION_SRCDIR) \
  MAIN_BINDIR=$(MAIN_BINDIR) \
  LIBGRAINS_SRCDIR=$(LIBGRAINS_SRCDIR) \
  LIBGRAINS_LIBDIR=$(LIBGRAINS_LIBDIR) \
  LIBGRAINS_OBJDIR=$(LIBGRAINS_OBJDIR) \
  LIBGRAINS_INCDIR=$(LIBGRAINS_INCDIR)  

ROTATION_SRCDIR := $(PREPOST_SRCDIR)/RotationMatrix
  
ROTATION_MAKE = @$(MAKE) -C $(ROTATION_SRCDIR) \
  MAIN_BINDIR=$(MAIN_BINDIR) \
  LIBGRAINS_SRCDIR=$(LIBGRAINS_SRCDIR) \
  LIBGRAINS_LIBDIR=$(LIBGRAINS_LIBDIR) \
  LIBGRAINS_OBJDIR=$(LIBGRAINS_OBJDIR) \
  LIBGRAINS_INCDIR=$(LIBGRAINS_INCDIR)

SHAPE_SRCDIR := $(PREPOST_SRCDIR)/ShapeFile
  
SHAPE_MAKE = @$(MAKE) -C $(SHAPE_SRCDIR) \
  MAIN_BINDIR=$(MAIN_BINDIR) \
  LIBGRAINS_SRCDIR=$(LIBGRAINS_SRCDIR) \
  LIBGRAINS_LIBDIR=$(LIBGRAINS_LIBDIR) \
  LIBGRAINS_OBJDIR=$(LIBGRAINS_OBJDIR) \
  LIBGRAINS_INCDIR=$(LIBGRAINS_INCDIR)
	
position:
	$(POSITION_MAKE) all
	
rotation:
	$(ROTATION_MAKE) all
	
shape:	
	$(SHAPE_MAKE) all
	
clean: 
	$(POSITION_MAKE) clean
	$(ROTATION_MAKE) clean
	$(SHAPE_MAKE) clean
