#
# Expects: PACIFIC_SRCDIR_ABS, PACIFIC_BUILDDIR_ABS
#

GRAINS_GPU_SRCDIR_ABS = $(PACIFIC_SRCDIR_ABS)/Grains3DGPU
GRAINS_GPU_BUILDDIR_ABS = $(PACIFIC_BUILDDIR_ABS)/Grains3DGPU

.PHONY: all objlibgrainsgpu libgrainsgpu grainsgpu testsgpu validationsgpu clean

all: libgrainsgpu grainsgpu testsgpu

#
# libGrains3DGPU.so + objects
#

LIBGRAINS_GPU_SRCDIR := $(GRAINS_GPU_SRCDIR_ABS)/Grains
LIBGRAINS_GPU_BUILDDIR := $(GRAINS_GPU_BUILDDIR_ABS)
LIBGRAINS_GPU_MAKE = @$(MAKE) -C $(LIBGRAINS_GPU_SRCDIR) \
  LIBGRAINS_GPU_BUILDDIR=$(LIBGRAINS_GPU_BUILDDIR)

objlibgrainsgpu:
	$(LIBGRAINS_GPU_MAKE) objlib

libgrainsgpu:
	$(LIBGRAINS_GPU_MAKE) all

#
# grains3dgpu binary
#

MAIN_GPU_SRCDIR := $(GRAINS_GPU_SRCDIR_ABS)/Main
MAIN_GPU_BUILDDIR := $(GRAINS_GPU_BUILDDIR_ABS)
MAIN_GPU_MAKE = @$(MAKE) -C $(MAIN_GPU_SRCDIR) \
  MAIN_GPU_BUILDDIR=$(MAIN_GPU_BUILDDIR) \
  LIBGRAINS_GPU_BUILDDIR=$(LIBGRAINS_GPU_BUILDDIR)

grainsgpu: libgrainsgpu
	$(MAIN_GPU_MAKE) all

#
# grains3dgpu_tests binary
#

TESTS_GPU_SRCDIR := $(GRAINS_GPU_SRCDIR_ABS)/Tests
TESTS_GPU_BUILDDIR := $(GRAINS_GPU_BUILDDIR_ABS)/Tests
TESTS_GPU_MAKE = @$(MAKE) -C $(TESTS_GPU_SRCDIR) \
  TESTS_GPU_BUILDDIR=$(TESTS_GPU_BUILDDIR) \
  LIBGRAINS_GPU_BUILDDIR=$(LIBGRAINS_GPU_BUILDDIR)
    
testsgpu: libgrainsgpu
	$(TESTS_GPU_MAKE) all

#
# Validations
#

VALIDATIONS_GPU_SRCDIR := $(GRAINS_GPU_SRCDIR_ABS)/Validations
VALIDATIONS_GPU_BUILDDIR := $(GRAINS_GPU_BUILDDIR_ABS)/Validations
VALIDATIONS_GPU_MAKE = @$(MAKE) -C $(VALIDATIONS_GPU_SRCDIR) \
  VALIDATIONS_GPU_BUILDDIR=$(VALIDATIONS_GPU_BUILDDIR) \
  LIBGRAINS_GPU_BUILDDIR=$(LIBGRAINS_GPU_BUILDDIR) 

validationsgpu: libgrainsgpu
	$(VALIDATIONS_GPU_MAKE) all

clean: 
	$(LIBGRAINS_GPU_MAKE) clean
	$(MAIN_GPU_MAKE) clean
	$(TESTS_GPU_MAKE) clean
